<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle Outer Orbit Ring -->
    <path
        android:pathData="M 54,26 A 28,28 0 1,1 53.9,26 Z"
        android:strokeWidth="3.2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="26"
                android:endX="82"
                android:endY="82"
                android:type="linear">
                <item android:color="#4F46E5" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="0.5" />
                <item android:color="#3B82F6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Glowing Core Sphere -->
    <path
        android:pathData="M 54,34 A 20,20 0 1,1 53.9,34 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="40"
                android:endX="68"
                android:endY="68"
                android:type="linear">
                <item android:color="#312E81" android:offset="0.0" />
                <item android:color="#1E1B4B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Lumina AI 4-Point Radiant Spark Star (Center at 54, 54) -->
    <path
        android:pathData="M 54,36 Q 54,54 36,54 Q 54,54 54,72 Q 54,54 72,54 Q 54,54 54,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="36"
                android:endX="72"
                android:endY="72"
                android:type="linear">
                <item android:color="#FFFFFF" android:offset="0.0" />
                <item android:color="#67E8F9" android:offset="0.4" />
                <item android:color="#A855F7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Small Companion Intelligence Sparkle at top right -->
    <path
        android:pathData="M 70,36 Q 70,41 65,41 Q 70,41 70,46 Q 70,41 75,41 Q 70,41 70,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="65"
                android:startY="36"
                android:endX="75"
                android:endY="46"
                android:type="linear">
                <item android:color="#38BDF8" android:offset="0.0" />
                <item android:color="#F43F5E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
