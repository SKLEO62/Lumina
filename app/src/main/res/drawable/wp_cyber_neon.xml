    <!-- Sky Gradient -->
    <path
        android:pathData="M0,0h360v640h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#06060D"
                android:centerColor="#100A1F"
                android:endColor="#05121E"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Glowing Cyber Sun / Orb -->
    <path
        android:pathData="M180,310m-70,0a70,70 0,1 1,140 0a70,70 0,1 1,-140 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#60F43F5E"
                android:centerColor="#30D946EF"
                android:endColor="#0506B6D4"
                android:type="linear" />
        </aapt:attr>
