                android:centerColor="#D946EF"
                android:endColor="#38BDF8"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Perspective Grid Ground -->
    <path
        android:pathData="M0,370h360v270h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#180A24"
                android:endColor="#040710"
