    <path android:strokeColor="#50D946EF" android:strokeWidth="1.2" android:pathData="M0,434h360" />
    <path android:strokeColor="#60D946EF" android:strokeWidth="1.3" android:pathData="M0,466h360" />
    <path android:strokeColor="#70D946EF" android:strokeWidth="1.4" android:pathData="M0,510h360" />
    <path android:strokeColor="#80D946EF" android:strokeWidth="1.6" android:pathData="M0,570h360" />
