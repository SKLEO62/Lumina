        android:pathData="M0,350 L20,350 L20,290 L45,290 L45,350 L55,350 L55,270 L80,270 L80,250 L95,250 L95,350 L110,350 L110,310 L135,310 L135,350 L150,350 L150,230 L160,200 L170,230 L170,350 L195,350 L195,280 L220,280 L220,350 L235,350 L235,260 L255,260 L255,350 L270,350 L270,300 L290,300 L290,350 L315,350 L315,240 L335,240 L335,350 L360,350">
