    <!-- Sun horizontal scanlines -->
    <path android:strokeColor="#50100A1F" android:strokeWidth="2.5" android:pathData="M110,290h140" />
    <path android:strokeColor="#60100A1F" android:strokeWidth="3.5" android:pathData="M115,302h130" />
