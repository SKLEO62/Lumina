    <!-- Grid Horizon Line -->
    <path
        android:strokeColor="#CC06B6D4"
        android:strokeWidth="2"
        android:pathData="M0,370h360" />

    <!-- Grid Longitudinal Lines (Perspective converging to (180, 360)) -->
    <path android:strokeColor="#3506B6D4" android:strokeWidth="1" android:pathData="M180,370 L-80,640" />
    <path android:strokeColor="#4006B6D4" android:strokeWidth="1" android:pathData="M180,370 L-20,640" />
