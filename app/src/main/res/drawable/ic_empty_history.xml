<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="96dp"
    android:height="96dp"
    android:viewportWidth="96"
    android:viewportHeight="96">
    <!-- Clock Outer Dial -->
    <path
        android:pathData="M 48,16 A 32,32 0 1,1 47.9,16 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:color="#1E1B4B" android:offset="0.0" />
                <item android:color="#0B0E14" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Dial Ring -->
    <path
        android:pathData="M 48,16 A 32,32 0 1,1 47.9,16 Z"
        android:strokeWidth="2.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="16"
                android:startY="16"
                android:endX="80"
                android:endY="80"
                android:type="linear">
                <item android:color="#818CF8" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Clock Hands (Back in time arrow) -->
    <path
        android:pathData="M 48,28 L 48,48 L 62,48"
        android:strokeColor="#38BDF8"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 48,48 A 4,4 0 1,1 47.9,48 Z"
        android:fillColor="#FFFFFF" />
    <!-- Small Celestial Stars -->
    <path
        android:pathData="M 76,20 Q 76,24 72,24 Q 76,24 76,28 Q 76,24 80,24 Q 76,24 76,20 Z"
        android:fillColor="#F43F5E" />
    <path
        android:pathData="M 22,68 Q 22,71 19,71 Q 22,71 22,74 Q 22,71 25,71 Q 22,71 22,68 Z"
        android:fillColor="#FBBF24" />
</vector>
