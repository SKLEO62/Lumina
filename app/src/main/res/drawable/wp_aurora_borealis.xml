<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="640dp"
    android:viewportWidth="360"
    android:viewportHeight="640">

    <!-- Sky Gradient -->
    <path
        android:pathData="M0,0h360v640h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#02090F"
                android:centerColor="#05161B"
                android:endColor="#02080D"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Aurora Wave Layer 1 (Emerald Glow) -->
    <path
        android:pathData="M-50,160 C40,90 120,240 220,130 C300,50 380,180 420,120 L420,380 C360,300 280,410 180,310 C100,230 20,350 -50,290 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="90"
                android:startColor="#0010B981"
                android:centerColor="#5534D399"
                android:endColor="#002DD4BF"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Aurora Wave Layer 2 (Cyan Curtain) -->
    <path
        android:pathData="M-30,220 C60,150 140,290 240,190 C320,110 390,230 430,170 L430,420 C360,340 260,430 160,350 C80,280 20,380 -30,340 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="75"
                android:startColor="#0006B6D4"
                android:centerColor="#4438BDF8"
                android:endColor="#00059669"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Aurora Ribbon Flow -->
    <path
        android:strokeWidth="18"
        android:pathData="M-40,200 C50,130 140,260 230,170 C310,100 380,210 420,160">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:angle="0"
                android:startColor="#006EE7B7"
                android:centerColor="#7034D399"
                android:endColor="#0038BDF8"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Stars in Arctic Sky -->
    <path android:fillColor="#E0FFFFFF" android:pathData="M40,60m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />
    <path android:fillColor="#C0A7F3D0" android:pathData="M110,40m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />
    <path android:fillColor="#E0FFFFFF" android:pathData="M230,55m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />
    <path android:fillColor="#A06EE7B7" android:pathData="M310,80m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />
    <path android:fillColor="#E0FFFFFF" android:pathData="M180,95m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />
    <path android:fillColor="#B0FFFFFF" android:pathData="M80,120m-1.5,0a1.5,1.5 0,1 1,3 0a1.5,1.5 0,1 1,-3 0" />
    <path android:fillColor="#FFFFFFFF" android:pathData="M270,140m-2,0a2,2 0,1 1,4 0a2,2 0,1 1,-4 0" />

    <!-- Mountain Ridge Far -->
    <path
        android:pathData="M-20,480 L40,430 L90,460 L140,400 L200,450 L260,390 L310,430 L380,380 L380,640 L-20,640 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#0D2024"
                android:endColor="#051014"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Mountain Ridge Near -->
    <path
        android:pathData="M-20,530 L60,470 L110,500 L170,440 L230,490 L290,450 L350,500 L380,480 L380,640 L-20,640 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#051417"
                android:endColor="#02080A"
                android:type="linear" />
        </aapt:attr>
    </path>

    <!-- Lake Reflection at Bottom -->
    <path
        android:pathData="M0,580h360v60h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:angle="270"
                android:startColor="#02080A"
                android:endColor="#061A1D"
                android:type="linear" />
        </aapt:attr>
    </path>
    <path android:strokeColor="#2034D399" android:strokeWidth="1.5" android:pathData="M40,595h120 M200,605h100 M80,618h180" />
</vector>
